   "source": [
    "def double_number(func):\n",
    "    def wrapper(*args, **kwargs):\n",
    "        return func(*args)*2\n",
    "    return wrapper"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a9de9d57",
   "metadata": {},
   "outputs": [],
   "source": [
    "@double_number\n",
    "def sum_numbers(*args):\n",
    "    s = 0\n",
    "    for arg in args:\n",
    "        s+=arg\n",
    "    return s"
   ]
  }
